# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# ruflo / claude-flow local runtime state (also keeps Tailwind v4's automatic
# content scan from walking into these binary/locked files)
/.swarm/
/.claude-flow/

# typescript
*.tsbuildinfo
next-env.d.ts

# design export (zip de referência do Claude Design)
*.zip

# configurações locais do Claude Code
/.claude/settings.local.json

# design export (zip de referência do Claude Design)
*.zip

# configurações locais do Claude Code
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
"/.claude/scheduled_tasks.lock"  

# Página do Instagram salva localmente (pode conter dados de sessão; não vai para o repositório)
/Instagram.html
/Instagram_files/

# Página do Instagram salva localmente (pode conter dados de sessão; não vai para o repositório)
/Instagram.html
/Instagram_files/
